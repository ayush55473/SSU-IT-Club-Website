# ==============================================================================
# SRI SRI UNIVERSITY (SSU) IT CLUB — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env` in the project root.
# 2. Create a free project at https://supabase.com
# 3. In your Supabase Dashboard: go to Project Settings -> API.
# 4. Copy "Project URL" into VITE_SUPABASE_URL.
# 5. Copy "anon public" key into VITE_SUPABASE_ANON_KEY.
# 6. Execute the `supabase_setup.sql` script in Supabase SQL Editor.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anon Public Key (Safe for frontend use with RLS enabled)
VITE_SUPABASE_ANON_KEY=

# Admin Dashboard Passcode (Change to your desired private admin passcode)
VITE_ADMIN_PASSCODE=SSUITCLUB@2026
